# CHANGE for your timezone in Canonical format
TZ_INFO="UTC"

# Default redis connection desined for the redis created by docker compose
# No need to change this
BROKER_REDIS_URL="redis://redis:6379/0"
REDBEAT_REDIS_URL="redis://redis:6379/1"

# Optional url safe base64 key
# Used to encode configurations in databases, without it, configuration is stored in plaintext!
# Can be generated by: openssl rand -base64 32 | tr '+/' '-_' | sed 's/=*$//'
ENCRYPTION_KEY= 

# A whitespace-separated list of plugin packages to install
PLUGINS= 